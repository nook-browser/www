---
import Logo from "./Logo.svelte";
import NavBar from "./NavBar.astro";
---

<header class="fixed top-0 md:top-2 left-0 right-0 z-50">
  <div
    class="grid items-center gap-2 sm:gap-3 md:gap-4 grid-cols-[auto_1fr] md:grid-cols-[1fr_auto_1fr] py-3 md:py-4 mx-4 sm:mx-8 md:mx-16"
  >
    <Logo className="w-8" href="/" />
    <NavBar />
    <div class="justify-self-end flex items-center gap-2">
      <a
        class="hidden sm:inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full border border-black/10 bg-white/70 backdrop-blur-md text-sm font-semibold shadow-[0px_1px_3px_0px_rgba(0,0,0,0.04),0px_4px_6px_0px_rgba(0,0,0,0.02),inset_0px_1px_0px_0px_rgba(255,255,255,0.7),inset_0px_-1px_2px_0px_rgba(0,0,0,0.03)] transition-all duration-200 hover:bg-white/90"
        href="https://github.com/nook-browser/nook"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="#5A5A5A"
          aria-hidden="true"
          ><path
            d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.36 6.84 9.72.5.1.68-.22.68-.48 0-.23-.01-.99-.01-1.79-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.12-1.5-1.12-1.5-.92-.64.07-.63.07-.63 1.02.07 1.56 1.07 1.56 1.07.9 1.59 2.36 1.13 2.94.86.09-.67.35-1.13.63-1.39-2.22-.26-4.56-1.14-4.56-5.09 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .85-.28 2.8 1.05a9.36 9.36 0 0 1 5.1 0c1.95-1.33 2.8-1.05 2.8-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.96-2.34 4.83-4.57 5.09.36.32.68.95.68 1.92 0 1.39-.01 2.51-.01 2.85 0 .26.18.58.69.48A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"
          ></path></svg
        >
        <span class="text-[#333333]">GitHub</span>
      </a>
      <a
        class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full text-white text-sm font-medium transition-all duration-200 hover:brightness-110 active:brightness-90 bg-[#1E1E1E] border border-white/10 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.1),0px_3px_3px_0px_rgba(0,0,0,0.08),0px_7px_4px_0px_rgba(0,0,0,0.05),0px_12px_5px_0px_rgba(0,0,0,0.02),0px_19px_5px_0px_rgba(0,0,0,0.01),inset_0px_-4px_4px_0px_rgba(255,255,255,0.1),inset_0px_0.5px_0px_0px_rgba(255,255,255,0.5)] [font-family:var(--font-rethink)]"
        href="/download"
      >
        <span>Download</span>
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden relative inline-flex items-center justify-center w-10 h-10 rounded-full border border-black/10 bg-white/70 backdrop-blur-md shadow-[0px_1px_3px_0px_rgba(0,0,0,0.04),0px_4px_6px_0px_rgba(0,0,0,0.02),inset_0px_1px_0px_0px_rgba(255,255,255,0.7),inset_0px_-1px_2px_0px_rgba(0,0,0,0.03)] transition-all duration-200 hover:bg-white/90"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <div class="hamburger-lines w-[16px] h-[12px] relative">
          <span class="absolute left-0 w-full h-[1.5px] bg-[#575757] rounded-full transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] top-0 origin-center"></span>
          <span class="absolute left-0 w-full h-[1.5px] bg-[#575757] rounded-full transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] top-1/2 -translate-y-1/2 origin-center"></span>
          <span class="absolute left-0 w-full h-[1.5px] bg-[#575757] rounded-full transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] bottom-0 origin-center"></span>
        </div>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 pointer-events-none"
  style="opacity: 0; backdrop-filter: blur(0px); -webkit-backdrop-filter: blur(0px); transition: opacity 0.5s cubic-bezier(0.25, 0.1, 0.25, 1), backdrop-filter 0.5s cubic-bezier(0.25, 0.1, 0.25, 1), -webkit-backdrop-filter 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);"
>
  <div
    class="absolute inset-0 opacity-0"
    id="mobile-menu-bg"
    style="background: rgba(241, 239, 223, 0.92); transition: opacity 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);"
  ></div>

  <div class="relative flex flex-col h-full px-8 pt-24 pb-10">
    <!-- Nav links -->
    <nav
      class="flex flex-col [font-family:var(--font-rethink)]"
      aria-label="Mobile"
    >
      <a href="/whats-new" class="mobile-nav-link mobile-nav-link-item">What's New</a>
      <a href="/roadmap" class="mobile-nav-link mobile-nav-link-item">Roadmap</a>
      <a href="/team" class="mobile-nav-link mobile-nav-link-item">Team</a>
      <a
        href="https://opencollective.com/nook-browser"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link mobile-nav-link-item"
      >Support Us</a>
    </nav>

    <!-- Bottom actions — pushed to bottom -->
    <div class="mt-auto flex flex-col gap-3">
      <a
        class="mobile-nav-link inline-flex items-center justify-center gap-2 w-full px-6 py-3.5 rounded-2xl text-white text-base font-medium bg-[#1E1E1E] border border-white/10 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.1),0px_3px_3px_0px_rgba(0,0,0,0.08),0px_7px_4px_0px_rgba(0,0,0,0.05),inset_0px_-4px_4px_0px_rgba(255,255,255,0.1),inset_0px_0.5px_0px_0px_rgba(255,255,255,0.5)] [font-family:var(--font-rethink)] transition-all duration-200 hover:brightness-110 active:brightness-90"
        href="/download"
      >
        <svg xmlns="http://www.w3.org/2000/svg" xml:space="preserve" width="14" height="14" viewBox="0 0 814 1000" fill="#fff"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"></path></svg>
        <span>Download for Mac</span>
      </a>
      <a
        class="mobile-nav-link inline-flex items-center justify-center gap-2 w-full px-6 py-3.5 rounded-2xl text-base font-medium text-[#373230] bg-white/60 border border-black/5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.04),inset_0px_1px_0px_0px_rgba(255,255,255,0.7)] [font-family:var(--font-rethink)] transition-all duration-200 hover:bg-white/80"
        href="https://github.com/nook-browser/nook"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="#5A5A5A" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.36 6.84 9.72.5.1.68-.22.68-.48 0-.23-.01-.99-.01-1.79-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.12-1.5-1.12-1.5-.92-.64.07-.63.07-.63 1.02.07 1.56 1.07 1.56 1.07.9 1.59 2.36 1.13 2.94.86.09-.67.35-1.13.63-1.39-2.22-.26-4.56-1.14-4.56-5.09 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .85-.28 2.8 1.05a9.36 9.36 0 0 1 5.1 0c1.95-1.33 2.8-1.05 2.8-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.96-2.34 4.83-4.57 5.09.36.32.68.95.68 1.92 0 1.39-.01 2.51-.01 2.85 0 .26.18.58.69.48A10.03 10.03 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"></path></svg>
        <span>Star on GitHub</span>
      </a>
    </div>
  </div>
</div>

<div class="h-14 sm:h-16 md:h-20"></div>

<style is:inline>
  /* Hamburger line-to-X morphing */
  .is-open .hamburger-lines span:nth-child(1) {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }
  .is-open .hamburger-lines span:nth-child(2) {
    opacity: 0;
    transform: translateY(-50%) scaleX(0);
  }
  .is-open .hamburger-lines span:nth-child(3) {
    bottom: auto;
    top: 50%;
    transform: translateY(-50%) rotate(-45deg);
  }

  /* Nav link items — left-aligned list with dividers */
  .mobile-nav-link-item {
    display: block;
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: #373230;
    padding: 1.1rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .mobile-nav-link-item:first-child {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .mobile-nav-link-item:active {
    opacity: 0.5;
  }

  /* All mobile-nav-link elements — base hidden state */
  .mobile-nav-link {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(4px);
    transition:
      opacity 0.5s cubic-bezier(0.25, 0.1, 0.25, 1),
      filter 0.5s cubic-bezier(0.25, 0.1, 0.25, 1),
      transform 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  /* When menu is open, links resolve into focus */
  .mobile-menu-open .mobile-nav-link {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0);
  }
</style>

<script is:inline>
  var btn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  var menuBg = document.getElementById('mobile-menu-bg');
  var links = menu.querySelectorAll('.mobile-nav-link');
  var isOpen = false;

  btn.addEventListener('click', function () {
    isOpen = !isOpen;
    btn.setAttribute('aria-expanded', String(isOpen));

    if (isOpen) {
      btn.classList.add('is-open');

      menu.classList.remove('pointer-events-none');
      menu.classList.add('pointer-events-auto');
      menu.style.opacity = '1';
      menu.style.backdropFilter = 'blur(44px)';
      menu.style.webkitBackdropFilter = 'blur(44px)';
      menuBg.style.opacity = '1';
      menu.classList.add('mobile-menu-open');

      // Stagger: nav items first, then bottom CTAs
      for (var i = 0; i < links.length; i++) {
        links[i].style.transitionDelay = (80 + i * 50) + 'ms';
      }

      document.body.style.overflow = 'hidden';
    } else {
      btn.classList.remove('is-open');

      menu.style.opacity = '0';
      menu.style.backdropFilter = 'blur(0px)';
      menu.style.webkitBackdropFilter = 'blur(0px)';
      menuBg.style.opacity = '0';
      menu.classList.remove('mobile-menu-open');

      for (var j = 0; j < links.length; j++) {
        links[j].style.transitionDelay = '0ms';
      }

      setTimeout(function () {
        if (!isOpen) {
          menu.classList.add('pointer-events-none');
          menu.classList.remove('pointer-events-auto');
        }
      }, 500);

      document.body.style.overflow = '';
    }
  });
</script>
