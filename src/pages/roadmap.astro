---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import { ClientRouter } from "astro:transitions";


type GHMilestone = {
  id: number;
  number: number;
  title: string;
  description?: string;
  open_issues: number;
  closed_issues: number;
  state: "open" | "closed";
  due_on?: string;
  html_url: string;
};

type GHIssue = {
  id: number;
  number: number;
  title: string;
  html_url: string;
  labels?: { name?: string }[];
};

const org = "nook-browser";
const repo = "nook";

async function fetchJSON<T>(url: string): Promise<T> {
  const res = await fetch(url, {
    headers: { Accept: "application/vnd.github+json" },
  });
  if (!res.ok) throw new Error(`Failed ${url}: ${res.status}`);
  return (await res.json()) as T;
}

let milestones: GHMilestone[] = [];
let backlog: GHIssue[] = [];
try {
  milestones = await fetchJSON<GHMilestone[]>(
    `https://api.github.com/repos/${org}/${repo}/milestones?state=open&sort=due_on&direction=asc`
  );
} catch {}

try {
  backlog = await fetchJSON<GHIssue[]>(
    `https://api.github.com/repos/${org}/${repo}/issues?state=open&labels=enhancement&per_page=50`
  );
} catch {}

function percent(closed: number, total: number): number {
  const t = Math.max(0, closed + total);
  if (!t) return 0;
  const p = Math.round((closed / t) * 100);
  return Number.isFinite(p) ? p : 0;
}

function shortDate(iso?: string): string {
  if (!iso) return "";
  return new Date(iso).toLocaleDateString(undefined, {
    month: "short",
    day: "numeric",
  });
}
---

<html
  lang="en"
  class="h-full bg-fixed bg-[length:100%_100%] bg-[linear-gradient(135deg,_#F1EFDF,_#F9F8F4)]"
>
  <head>
    <meta charset="utf-8" />
    <ClientRouter />

    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Roadmap — Nook Browser</title>
    <SEO
      title="Roadmap — Nook Browser"
      description="What's in flight and what's next for Nook Browser."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Urbanist:wght@600;700;800&family=Inter:wght@400;500;600;700;800&family=Rethink+Sans:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen w-full text-[#1b1b18] antialiased">
    <Header />

    <!-- Header -->
    <section
      class="container mx-auto max-w-[1120px] px-[clamp(16px,5vw,28px)] text-center pt-[clamp(72px,18vw,120px)] pb-0"
      data-reveal-parent
    >
      <h1
        class="font-medium tracking-tight leading-[1.1] text-2xl sm:text-3xl md:text-4xl [font-family:var(--font-rethink)] text-[#373230]"
        data-reveal
      >
        Roadmap
      </h1>
      <p
        class="mt-3 text-[#6b6b62] text-[clamp(13px,1.4vw,16px)] leading-normal"
        data-reveal
        data-reveal-delay="90"
      >
        What's in flight and what's next for Nook.
      </p>
    </section>

    <!-- Milestones -->
    <section
      class="container mx-auto max-w-[860px] px-[clamp(16px,5vw,28px)] pt-[clamp(32px,8vw,56px)]"
    >
      <div class="flex items-center justify-between mb-4 animate-blur-in" style="--stagger: 0">
        <h2 class="text-sm font-medium text-[#9b9688]">
          Focus
        </h2>
        <a
          href={`https://github.com/${org}/${repo}/milestones`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-[#9b9688] hover:text-[#373230] transition-colors duration-150"
        >View on GitHub</a>
      </div>

      {
        milestones.length === 0 && (
          <div
            class="rounded-2xl border border-[#e2dec7] bg-white/50 p-8 text-center text-[#9b9688] text-sm animate-blur-in"
            style="--stagger: 1"
          >
            No active milestones right now.
          </div>
        )
      }

      <div
        class="rounded-2xl border border-[#e2dec7] bg-white/50 backdrop-blur-sm shadow-[0px_1px_3px_0px_rgba(0,0,0,0.03),inset_0px_1px_0px_0px_rgba(255,255,255,0.5)] overflow-hidden divide-y divide-[#e2dec7] animate-blur-in"
        style="--stagger: 1"
      >
        {
          milestones.map((m, i) => {
            const pct = percent(m.closed_issues, m.open_issues);
            const total = m.closed_issues + m.open_issues;
            return (
              <a
                href={m.html_url}
                target="_blank"
                rel="noopener noreferrer"
                class="roadmap-row flex items-center gap-4 px-5 py-4 transition-colors duration-150 hover:bg-white/60 animate-blur-in"
                style={`--stagger: ${i + 1}`}
              >
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2.5 flex-wrap">
                    <span class="text-sm font-medium text-[#373230] line-clamp-1">
                      {m.title}
                    </span>
                    <div class="roadmap-badges flex items-center gap-1.5">
                      <span class="rounded-full bg-[#efe9d0] text-[#07140f]/50 border border-[#e2dec7] px-2 py-0.5 text-[10px] font-semibold tabular-nums">
                        {pct}%
                      </span>
                      {m.due_on && (
                        <span class="hidden sm:inline-flex rounded-full bg-[#efe9d0] text-[#07140f]/50 border border-[#e2dec7] px-2 py-0.5 text-[10px] font-semibold">
                          {shortDate(m.due_on)}
                        </span>
                      )}
                    </div>
                  </div>
                  {m.description && (
                    <p class="mt-1 text-xs text-[#9b9688] line-clamp-1">
                      {m.description}
                    </p>
                  )}
                </div>
                <div class="shrink-0 text-xs tabular-nums text-[#9b9688] hidden sm:block">
                  {m.closed_issues}/{total}
                </div>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- Backlog -->
    <section
      class="container mx-auto max-w-[860px] px-[clamp(16px,5vw,28px)] pt-[clamp(40px,8vw,64px)] pb-[clamp(42px,10vw,96px)]"
    >
      <div class="flex items-center justify-between mb-5 animate-blur-in" style={`--stagger: ${milestones.length + 2}`}>
        <h2 class="text-sm font-medium text-[#9b9688]">
          Ideas & backlog
        </h2>
        <a
          href={`https://github.com/${org}/${repo}/issues/new/choose`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium text-[#373230] transition-all duration-200 hover:brightness-95 active:brightness-90 bg-white border border-black/5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05),0px_4px_4px_0px_rgba(0,0,0,0.02),inset_0px_-2px_2px_0px_rgba(0,0,0,0.02),inset_0px_1px_0px_0px_rgba(255,255,255,1)]"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M12 5v14" />
            <path d="M5 12h14" />
          </svg>
          Suggest
        </a>
      </div>

      {
        backlog.length === 0 && (
          <div
            class="rounded-2xl border border-[#e2dec7] bg-white/50 p-8 text-center text-[#9b9688] text-sm animate-blur-in"
            style={`--stagger: ${milestones.length + 3}`}
          >
            No backlog items yet.
          </div>
        )
      }

      <div
        class="rounded-2xl border border-[#e2dec7] bg-white/50 backdrop-blur-sm shadow-[0px_1px_3px_0px_rgba(0,0,0,0.03),inset_0px_1px_0px_0px_rgba(255,255,255,0.5)] overflow-hidden divide-y divide-[#e2dec7] animate-blur-in"
        style={`--stagger: ${milestones.length + 3}`}
      >
        {
          backlog.slice(0, 15).map((it, i) => (
            <a
              href={it.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="roadmap-row flex items-center gap-4 px-5 py-4 transition-colors duration-150 hover:bg-white/60 animate-blur-in"
              style={`--stagger: ${milestones.length + 3 + i}`}
            >
              <span class="shrink-0 text-xs tabular-nums text-[#9b9688]/60 w-6 text-right">
                #{it.number}
              </span>
              <span class="flex-1 min-w-0 text-sm font-medium text-[#373230] line-clamp-1">
                {it.title}
              </span>
              {Array.isArray(it.labels) && it.labels.length > 0 && (
                <div class="hidden sm:flex items-center gap-1.5 shrink-0">
                  {it.labels.slice(0, 2).map((l) => (
                    <span class="rounded-full bg-[#efe9d0] text-[#07140f]/50 border border-[#e2dec7] px-2 py-0.5 text-[10px] font-semibold">
                      {l?.name}
                    </span>
                  ))}
                </div>
              )}
            </a>
          ))
        }
      </div>

      {
        backlog.length > 15 && (
          <div class="mt-4 text-center animate-blur-in" style={`--stagger: ${milestones.length + 18}`}>
            <a
              href={`https://github.com/${org}/${repo}/issues?q=is%3Aissue+is%3Aopen+label%3Aenhancement`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-[#9b9688] hover:text-[#373230] transition-colors duration-150"
            >
              View all {backlog.length} ideas on GitHub
            </a>
          </div>
        )
      }
    </section>

    <Footer />

  </body>
</html>
