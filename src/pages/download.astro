---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import { ClientRouter } from "astro:transitions";
import { fetchReleases, releasesPage } from "../lib/releases";

export const prerender = false;

const release = (await fetchReleases())[0] ?? null;
const versionLabel = release?.tag ?? "Latest";
const downloadUrl = release?.dmg ?? releasesPage;
---

<html
  lang="en"
  class="h-full bg-fixed bg-[length:100%_100%] bg-[linear-gradient(135deg,_#F1EFDF,_#F9F8F4)]"
>
  <head>
    <meta charset="utf-8" />
    <ClientRouter />

    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Download — Nook Browser</title>
    <SEO
      title="Download — Nook Browser"
      description="Get the latest macOS build of Nook."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Urbanist:wght@600;700;800&family=Inter:wght@400;500;600;700;800&family=Rethink+Sans:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen w-full text-[#1b1b18] antialiased h-full">
    <Header />

    <section
      class="container mx-auto max-w-[1120px] px-[clamp(16px,5vw,28px)] text-center pt-[clamp(72px,18vw,120px)] pb-0 h-full"
      data-reveal-parent
    >
      <div class="flex flex-col items-center justify-center" data-reveal>
        <img src="/favicon.png" alt="Nook" class="w-16 h-16 sm:w-24 sm:h-24" />
      </div>
      <h1
        data-reveal
        data-reveal-delay="70"
        class="mt-8 font-medium tracking-tight leading-[1.1] text-4xl sm:text-5xl md:text-6xl [font-family:var(--font-rethink)] text-[#373230]"
      >
        Download Nook
      </h1>
      <p
        data-reveal
        data-reveal-delay="120"
        class="mt-3 mx-auto max-w-[720px] text-[#6b6b62] text-[clamp(14px,1.6vw,18px)] leading-normal"
      >
        Get the latest release for your operating system. Open-source,
        private, and fast by design.
      </p>

      <div
        class="mt-[26px] flex justify-center gap-3"
        data-reveal
        data-reveal-delay="160"
      >
        <a
          href={downloadUrl}
          class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-2xl text-white text-base font-medium transition-all duration-200 hover:brightness-110 active:brightness-90 bg-[#1E1E1E] border border-white/10 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.1),0px_3px_3px_0px_rgba(0,0,0,0.08),0px_7px_4px_0px_rgba(0,0,0,0.05),0px_12px_5px_0px_rgba(0,0,0,0.02),0px_19px_5px_0px_rgba(0,0,0,0.01),inset_0px_-4px_4px_0px_rgba(255,255,255,0.1),inset_0px_0.5px_0px_0px_rgba(255,255,255,0.5)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            xml:space="preserve"
            width="14"
            height="14"
            viewBox="0 0 814 1000"
            fill="#fff"
            ><path
              d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
            ></path></svg
          >
          <span>Download</span>
        </a>
        <a
          class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-2xl text-base font-medium transition-all duration-200 hover:brightness-95 active:brightness-90 bg-white border border-black/5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05),0px_4px_4px_0px_rgba(0,0,0,0.02),inset_0px_-2px_2px_0px_rgba(0,0,0,0.02),inset_0px_1px_0px_0px_rgba(255,255,255,1)]"
          href="/whats-new"><span>What's New</span></a
        >
      </div>
      {
        release && (
          <p class="mt-4 text-xs text-[#6b6b62]">
            Latest version: {versionLabel}
          </p>
        )
      }
    </section>

    <Footer />
  </body>
</html>
