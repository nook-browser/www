---
import Logo from "../../components/Logo.svelte";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import SEO from "../../components/SEO.astro";
import { ClientRouter } from "astro:transitions";
import { fetchReleases } from "../../lib/releases";

export const prerender = false;

const { slug } = Astro.params;
const release = (await fetchReleases()).find((r) => r.tag === slug);

// Old CMS slugs and releases older than the feed's window land on the list.
if (!release) {
  return Astro.redirect("/whats-new");
}

const entry = {
  title: `Nook ${release.version}`,
  version: release.tag,
  publishedAt: release.date,
  summary: release.summary,
  url: release.url,
  dmg: release.dmg,
};
const bodyHtml = release.html;
const dateObj = new Date(entry.publishedAt);

function monthLabel(d: Date): string {
  return d.toLocaleDateString(undefined, { month: "long", year: "numeric" });
}

function shortDay(d: Date): string {
  return d.toLocaleDateString(undefined, { month: "short", day: "numeric" });
}

const badgeStyle = "bg-[#efe9d0] text-[#07140f]/50 border border-[#e2dec7]";
---

<html
  lang="en"
  class="h-full bg-fixed bg-[length:100%_100%] bg-[linear-gradient(135deg,_#F1EFDF,_#F9F8F4)]"
>
  <head>
    <meta charset="utf-8" />
    <ClientRouter />

    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.title} — What's New</title>
    <SEO
      title={`${entry.title} — What's New`}
      description={entry.summary ?? "Nook release note."}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Urbanist:wght@600;700;800&family=Inter:wght@400;500;600;700;800&family=Rethink+Sans:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen w-full text-[#07140f] antialiased">
    <Header />

    <section
      class="max-w-3xl mx-auto px-6 pt-20 md:pt-28 pb-14"
      data-reveal-parent
    >
      <div class="text-sm text-[#07140f]/50" data-reveal>
        <a href="/whats-new" class="hover:text-[#07140f] transition-colors duration-150">Changelog</a>
        <span class="mx-1.5 text-[#07140f]/30">/</span>
        <span>{monthLabel(dateObj)}</span>
      </div>
      <h1
        data-reveal
        data-reveal-delay="70"
        class="mt-2 text-[clamp(1.8rem,4.8vw,2.75rem)] font-semibold tracking-tight text-[#171717] [font-family:var(--font-rethink)]"
      >
        {entry.title}
      </h1>
      <div
        class="mt-3 flex items-center gap-3"
        data-reveal
        data-reveal-delay="120"
      >
        <time datetime={entry.publishedAt} class="text-sm text-[#07140f]/60"
          >{shortDay(dateObj)}</time
        >
        <div class="flex items-center gap-1.5">
          {
            entry.version && (
              <span class={`rounded-full px-2 py-0.5 text-[11px] font-semibold ${badgeStyle}`}>
                {entry.version}
              </span>
            )
          }
        </div>
      </div>
      <article class="changelog-body mt-6" data-reveal data-reveal-delay="180">
        <div
          class="[&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-[#373230] [&_h3]:mt-6 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:tracking-tight [&_h3]:text-[#373230] [&_ul]:mt-2 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mt-1 [&_li]:leading-relaxed [&_li]:text-[#07140f]/80 [&_p]:text-[#07140f]/80 [&_p]:leading-relaxed [&_p+*]:mt-3 [&_a]:underline [&_a]:underline-offset-2"
          set:html={bodyHtml}
        />
      </article>
      <div class="mt-8 flex gap-4 text-sm" data-reveal data-reveal-delay="210">
        <a href={entry.dmg} class="font-medium text-[#07140f] underline underline-offset-2">Download {entry.version}</a>
        <a href={entry.url} target="_blank" rel="noopener noreferrer" class="text-[#07140f]/70 hover:text-[#07140f]">View on GitHub</a>
      </div>
      <div
        class="mt-12 border-t border-[#e2dec7] pt-6 text-sm text-[#07140f]/60"
        data-reveal
        data-reveal-delay="240"
      >
        <a href="/whats-new" class="inline-flex items-center gap-1.5 hover:text-[#07140f] transition-colors duration-150"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>Back to changelog</a
        >
      </div>
    </section>

    <Footer />
  </body>
</html>
